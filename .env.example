# Copy to .env (never commit it; chmod 600). nt-sync reads it at startup; real environment variables win over it.
NT_API_URL=https://HOST/api.php
NT_API_KEY=replace-with-the-key-configured-in-CI_PUBLICACION_API_KEYS
REDIS_ADDR=redis-host:6379
#REDIS_PASSWORD=
#REDIS_DB=0
#REDIS_TLS=false
#REDIS_PREFIX=nt
#REDIS_KEEP_VERSIONS=2
#POLL_INTERVAL=30s
#SQLITE_PATH=data/nt.db
#NT_INDEX_FIELDS=cum_facturar,cod_auf,cod_mutual,estado,contrato,referencia_siesa
NT_SEARCH_FIELDS=descripcion,descripcion_siesa
